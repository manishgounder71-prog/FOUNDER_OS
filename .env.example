# FounderOS Environment Variables

# OpenAI API Key (Required for Lyzr agents and default embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (Optional fallback for text generation and transcription)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Database Storage Path (Defaults to local file storage `./qdrant_db`)
QDRANT_PATH=./qdrant_db

# Qdrant Cloud Settings (Optional: Provide URL and API Key to connect to a Qdrant Cloud cluster instead of local files)
QDRANT_URL=your_qdrant_cloud_url_here
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Server Configuration
HOST=127.0.0.1
PORT=8000
